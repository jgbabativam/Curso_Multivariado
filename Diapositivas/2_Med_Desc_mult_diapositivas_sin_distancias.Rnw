\section{Vector de medias o centroide, matriz de covarianzas y matriz de correlación}
\begin{frame}
\textbf{Vector de medias o centroide}
\begin{align}
med(X) = \bar{x} = \frac1n \mathbf{1_n}^\prime X = 
\left[ \begin{array}{c}
\bar{x}_1\\
\bar{x}_2\\
\vdots\\
\bar{x}_p
\end{array} \right] , \quad \text{donde} \quad
\mathbf{1_n} = \left[ \begin{array}{c}
1\\
1\\
\vdots\\
1_n
\end{array} \right]
\end{align}
\end{frame}

% 
\begin{frame}{Ejemplo vector de medias}
El vector de medias de las variables de la tabla de ciudades expresado como un vector es: $\bar{x}^\prime = (888021.77, 0.12, 1.09, 0.21, 23.27)^\prime$, el cual, en formato de tabla se muestra en la tabla\ref{tab:VecMedias} :
<<echo=F,results=tex>>=
# med<-round(t(colMeans(ciudades[,2:6])),2)
med<-as.data.frame(round(colMeans(ciudades[,2:6]),2))
colnames(med)<-c("Media")
@

<<echo=F, results=tex>>=
kable(med, "latex", booktabs = T, 
      caption = "Vector de medias para variables de educación 
      de la tabla de ciudades", label = "VecMedias") %>% 
  kable_styling(latex_options = c("striped", "hold_position"))
@
\end{frame}
% 
\begin{frame}{Matriz de datos centrados}
\begin{equation}\label{m_dat_cent}
	 \tilde{X} = X - \mathbf{1_n}\bar{x}^\prime = \left[ \begin{array}{cccc}
		
		{x_{11}-\bar{x}_1} & {x_{12}-\bar{x}_2} & \cdots &{x_{1p}-\bar{x}_p} \\
		{x_{21}-\bar{x}_1} & {x_{22}-\bar{x}_2} & \cdots &{x_{2p}-\bar{x}_p}\\
		\vdots& \vdots               & \vdots& \vdots\\
		{x_{n1}-\bar{x}_1} & {x_{n2}-\bar{x}_2} & \cdots& {x_{np}-\bar{x}_p}
	\end{array} \right], \, \left\{\tilde{x}_{ij} \right\} = 
	\left\{ {x_{ij}- \bar{x}_j} \right\}
\end{equation}
Observese que 
\begin{equation}\label{media_m_dat_cent}
	med(\tilde{X}) = \frac1n \tilde{X}^\prime\mathbf{1_n} = \left( \frac1n X^\prime\mathbf{1_n} - \frac1n \bar{x}^\prime \mathbf{1_n}^\prime \mathbf{1_n}\right)  = 0
\end{equation}
\end{frame}
%
\begin{frame}[containsverbatim, allowframebreaks]
\frametitle{Matriz de datos centrados}
Se puede comprobar fácilmente que todas las variables tienen media cero.

<<results = tex, echo=F>>=
Xtil<-scale(ciudades[,2:6], scale = FALSE)
@

<<results = tex, echo=F>>=
kable(Xtil, "latex", booktabs = T, digits = 3,
      caption = "Matriz de datos centrados", label = "DatosCent") %>% 
  kable_styling(latex_options = c("striped", "hold_position","scale_down"))
@
\end{frame}
%
\begin{frame}{Matriz de covarianzas}
$$ S = \frac1n \tilde{X}^\prime \tilde{X} =  \left[ \begin{array}{cccc}
s_1^2& s_{12}& \cdots& s_{1p}\\
s_{21}& s_2^2& \cdots& s_{2p}\\
\vdots& \vdots& \vdots& \vdots\\
s_{p1}& s_{p2}& \cdots& s_p^2
\end{array} \right], \quad s_j^2 = s_{jj} $$
Nótese que comunmente se utiliza el estimador insesgado para la varaianza $s_j = \frac{1}{(n-1)} \sum_{i=1}^n (x_{ij}-\bar{x}_j)^2 $, $j=1,\ldots, p$. 
\vskip1mm
Sin embargo, cuando se trata de datos poblacionales como es el caso de los datos de las ciudades colombianas, o cuando $n$ es suficientemente grande, se puede utilizar como denominador $n$ debido a que por ejemplo para $n>100$, la diferencia entre dividir por $n$ y por $n-1$ resulta despreciable.
\end{frame}
% 

\begin{frame}{Matriz de datos centrados estandarizados}
\footnotesize
La matriz de datos centrados estandarizados se obtiene al estandarizar la matriz de datos centrados $\widetilde{X}$:
\begin{align}\label{Y_centr}
\widetilde{Y}=\widetilde{X}D^{-1/2}, 
\qquad 
D=\mathrm{diag}\{s_j^2\}, 
\qquad 
D^{-1/2}=\mathrm{diag}\left\{\frac{1}{s_j}\right\}.
\end{align}
\vspace{-0.2cm}
Explícitamente,
\[
\widetilde{Y} =
\begin{bmatrix}
\dfrac{x_{11}-\bar{x}_1}{s_1} & \dfrac{x_{12}-\bar{x}_2}{s_2} & \cdots & \dfrac{x_{1p}-\bar{x}_p}{s_p}\\
\dfrac{x_{21}-\bar{x}_1}{s_1} & \dfrac{x_{22}-\bar{x}_2}{s_2} & \cdots & \dfrac{x_{2p}-\bar{x}_p}{s_p}\\
\vdots & \vdots & \ddots & \vdots\\
\dfrac{x_{n1}-\bar{x}_1}{s_1} & \dfrac{x_{n2}-\bar{x}_2}{s_2} & \cdots & \dfrac{x_{np}-\bar{x}_p}{s_p}
\end{bmatrix}
\]

Utilizando (\ref{m_dat_cent}) se obtiene que el vector de medias de $\widetilde{Y}$ es nulo:

\[
med(\widetilde{Y})=\widetilde{Y}^{\prime}\mathbf{1}_n
= D^{-1/2}\widetilde{X}^{\prime}\mathbf{1}_n
= D^{-1/2}\cdot 0
=0
\]

\end{frame}
% 

% 
\begin{frame}{Matriz de correlación}
Es una matriz simétrica que contiene unos en la diagonal que son las correlaciones de las variables consigo mismas y por fuera de la diagonal las correlaciones $r_{ij}$ entre pares de variables. Se define por
\begin{align}\label{m_cor}
	R=D^{-1/2}SD^{-1/2}
\end{align}
y también se obtiene a partir de la matriz de datos centrados estandarizados así:
\begin{equation}\label{ec:matCor}
	R = \frac1n \widetilde{Y}^\prime \widetilde{Y} = \left[ \begin{array}{cccc}
   1  & r_{12}& \cdots& r_{1p}\\
r_{21}&    1  & \cdots& r_{2p}\\
\vdots& \vdots& \vdots& \vdots\\
r_{p1}& r_{p2}& \cdots&    1
\end{array} \right], \quad r_{ij}=\frac{s_{ij}}{s_is_j}
\end{equation}
\end{frame}
% 
\begin{frame}
Nótese que la matriz de covarianzas de $\widetilde{Y}$ es también $R$ puesto que
\begin{align}\label{s_Y_tilde}
S_{_{\widetilde{Y}}} = \frac1n \widetilde{Y}^\prime \widetilde{Y} = \frac1n D^{-1/2} \widetilde{X}^\prime \widetilde{X} D^{-1/2} = D^{-1/2} S D^{-1/2} = R
\end{align}
\end{frame}
% 
\begin{frame}{Matriz de datos centrados, estandarizados y normados}

\small

A partir de la matriz de datos centrados estandarizados $\widetilde{Y}$ se define la
\textbf{matriz de datos centrados, estandarizados y normados}
\vskip-1mm
\begin{align}\label{Y_c_est}
Y=\frac{1}{\sqrt{n}}\widetilde{Y}
   =\frac{1}{\sqrt{n}}\widetilde{X}D^{-1/2}.
\end{align}
Esta matriz también está centrada puesto que
\[
med(Y)=\frac{1}{\sqrt{n}}\,med(\widetilde{Y})=0 .
\]
Además, al estar autoponderada por $\frac{1}{\sqrt{n}}$, el producto de la matriz consigo misma produce su matriz de covarianzas, que coincide con la matriz de correlaciones:
\vskip-1mm
\begin{equation}
S_Y=Y^\prime Y
   =\frac{1}{n}\widetilde{Y}^\prime\widetilde{Y}
   =R .
\end{equation}
\end{frame}
% 
\begin{frame}{Varianza total}

\small

La \textbf{varianza total} es un indicador de la variabilidad global de una matriz de datos.
Se define como la suma de las varianzas de las variables:

\begin{equation}
V_T = \sum_{j=1}^{p} s_j^2
\end{equation}

donde \(s_j^2\) es la varianza de la variable \(X_j\).

\vspace{0.3cm}

En particular, para las matrices de datos centrados y estandarizados se tiene

\[
S_{\widetilde{Y}} = S_Y = R
\]

donde \(R\) es la matriz de correlaciones.

\vspace{0.2cm}

Como la diagonal de \(R\) está compuesta por unos, se obtiene

\begin{equation}
V_T(\widetilde{Y}) = V_T(Y) = \mathrm{tr}(R) = p .
\end{equation}

\end{frame}
%
\begin{frame}{Ejemplo}
Matriz de covarianzas entre las variables del archivo de ciudades.

<<vars, echo=F>>=
MC<-round(var(ciudades[,2:6]),3)
@

<<echo=F, results=tex>>=
kable(MC, "latex", booktabs = T, 
      caption = "Matriz de covarianzas de las variables del archivo de ciudades", label = "MatCov") %>% 
  kable_styling(latex_options = c("striped", "hold_position","scale_down"))
@
\end{frame}
% 
\begin{frame}{Ejemplo}
Matriz correlación entre las variables de la tabla de ciudades.
<<echo=F>>=
MCor<-round(cor(ciudades[,2:6]),2)
@

<<echo=F, results=tex>>=
kable(MCor, "latex", booktabs = T, 
      caption = "Matriz de correlación de las variables 
      del archivo de ciudades", label = "MatCor") %>% 
  kable_styling(latex_options = c("striped", "hold_position","scale_down"))
@
\end{frame}
% 



% 
\section{combinaciones lineales}
\begin{frame}{Combinaciones lineales}
Una combinación lineal es una suma ponderada de los valores de una variable observada en varios objetos, como lo es la media por ser la suma de los valores de la variable ponderados por $1/n$, o como la varianza que es la suma de los desvíos de los valores de la variable respecto a la media $(x_i-\bar{x})^2$ poderados por $1/n$.
\end{frame}

\begin{frame}{Combinaciones lineales}
También es combinación lineal la una suma ponderada de los valores de varias variables observadas en un mismo objeto. Por ejemplo:
\vskip1mm
Los rankings de universidades
\vskip1mm
El índice de pobreza multidimensional es una combinación lineal de indicadores de vivienda, servicios básicos, estándar de vida, educación y empleo, y protección social; 
\vskip1mm
El índice de desarrollo humano que podera indicadores de dimensiones como la esperanza de vida, educación y riqueza. \vskip1mm
La mayoría de los índices o indicadores utilizados en economía y finanzas para describir y comparar cantidades de diferente naturaleza.
\end{frame}

\begin{frame}{Combinaciones lineales}
Las combinaciones lineales son útiles en muchos contextos estadísticos y especialmente en el caso de datos multivariados, donde por ejemplo, \textcolor{blue}{las componentes principales son combinaciones lineales de los valores de las variables cuyas ponderaciones se construyen para que contengan la mayor cantidad  posible de la varianza de las variables.}
\end{frame}

\begin{frame}{Combinación lineal de los valores de una variable observada en $n$ objetos}
Sea $X_{.j}$ la $j$-ésima columna de la matriz de datos 
% como se definió en \ref{ec:columnasX}. 
Se define la combinación de los $n$ valores de la variable $j$ con constantes de ponderación $a^\prime = (a_1,\ldots,a_n)^\prime$ por:
\begin{eqnarray}\label{CLineal}\label{ec:CoLin}
X^\star_j = a^\prime X_{.j} = \sum_{i=1}^n a_ix_{ij} \quad j=1,\ldots,p. 
\end{eqnarray}

\begin{ejem}
El promedio de la variable $j$ es una combinación lineal con constantes de ponderación $p^\prime = (\frac1n,\ldots,\frac1n)$:
\begin{equation}
\bar{x}_j = p^\prime X_{.j} = \sum_{i=1}^n \frac1n x_{ij} 
\end{equation}
% donde $X_{.j}$ es la $j$-ésima columna de $X$
% como en \ref{ec:columnasX}.
\end{ejem}
\end{frame}

\begin{frame}{Combinación lineal de valores de $p$ variables observadas sobre un mismo objeto}
Para el objeto $i$ cuyas observaciones están en la fila  $x_{i.}$ de la matriz de datos, se define la  combinación lineal de los valores de las $p$ variables con ponderaciones $b^\prime = (b_1,\ldots,b_p)$ por:

\begin{eqnarray}\label{CLineal}\label{ec:CoLin}
z_i = b^\prime x_{i.} = \sum_{j=1}^p b_jx_{ij}   \ \ \  i=1,\ldots,n 
\end{eqnarray}
donde $x_i$ es como en (\ref{fila_i}).
Conviene aclarar que este tipo de combinaciones lineales solo tienen sentido si las variables están estandarizadas, o cuando todas vienen medidas en las mismas escalas.
\end{frame}

\begin{frame}[containsverbatim, allowframebreaks]
\frametitle{Ejemplo. El Academic Rank of World Universities}
\footnotesize
Uno de los más exigentes rankings del mundo es el Academic Rank of World Universities (ARWU) que utiliza los siguientes seis criterios (en paréntesis las pondetaciones de cada criterio)
\begin{itemize}
	\item Premios Nobel de exalumnos (Score on Alumni: $X_1$) (10\%)
	\item Premios Nobel de docentes de la universidad (Score on Award: $X_2$) (20\%)
	\item Artículos altamente citados en 21 categor?as tem?ticas (Score on HiCi: $X_3$) (20\%)
	\item Artículos publicados en las reconocidas revistas Nature y Science (Score on N\&S: $X_4$) (20\%) 
	\item Artículos indexados en alguno de los índices de citación como el Science Citation Index-expanded o en el Social Science Citation Index (Score on PUB: $X_5$) (20\%) 
	\item Productividad per cápita de los docentes de la universidad (Score on PCP: $X_6$) (10\%)
\end{itemize}
\end{frame}

\begin{frame}[containsverbatim, allowframebreaks]
\frametitle{Ejemplo. El Academic Rank of World Universities}
\small
Los valores de los rankings para las primeras 10 universidades en el año 2013
\setlength{\abovecaptionskip}{-1pt}
<<arwu, results=tex, echo=F>>=
arwu<-read.csv2("G:/Mi unidad/1- multivariado aplicado 2023/Multivariado I 2024 Diapositivas/Archivos para diapositivas/ARWU_100_top.csv")
arwu<-arwu[, -c(2:6)]
rownames(arwu)<-arwu[,1]; arwu[,1]<-NULL
arwu<-arwu[1:10,]
arw<-xtable(arwu, digits = 1 )
kable(arwu, "latex", booktabs = TRUE,
      caption = "Puntajes de las diez primeras universidades del ARWU",
      label = "tab:RankArwu") %>%
  kable_styling(latex_options = c("striped","scale_down"))
@
\end{frame}

\begin{frame}{Ejemplo. El Academic Rank of World Universities}
El puntaje del ranking es una combinación lineal de los puntajes obtenidos por una universidad en los criterios, con ponderaciones $b^\prime = (0.1, 0.2, 0.2, 0.2, 0.2, 0.1) $, de manera que por ejemplo para la universidad de Harvard, cuyos puntajes en los criterios que están en la fila uno de la  tabla \ref{tab:RankArwu} son  \vskip1mm
$x_1=$(100, 100, 100, 100, 100, 69.2),\vskip1mm 
de manera que el valor de su  puntaje total en el ranking es:
\begin{align*}
	y_i&=0.1\times 100+0.2\times 100+0.2\times 100+0.2\times 100+0.2\times 100\\
	& +0.1\times 69.2=0.9692
\end{align*}
Ajustado a 100 en la tabla como máximo valor de referencia. 
\end{frame}
% 
\begin{frame}{Teorema de la descomposición espectral (\textbf{TDE})}

\small

Este teorema garantiza que una matriz simétrica 
$B_{p\times p}$, como la matriz de covarianzas o de correlación 
(ambas semidefinidas positivas), se puede reconstruir (o factorizar) 
a partir de sus \textbf{valores} y \textbf{vectores propios} como sigue:

\vspace{0.3cm}

\begin{equation}\label{TDespectr}
B = U \Lambda U^\prime
\end{equation}

\vspace{0.3cm}

donde:

\begin{itemize}
    \item $U_{p\times p}$ es una \textbf{matriz ortogonal}, cuyas columnas son los 
    \textbf{vectores propios estandarizados de} $B$, es decir,
    \[
    U^\prime U = U U^\prime = I_p.
    \]
    
    \item $\Lambda = \mathrm{diag}(\lambda_1,\ldots,\lambda_p)$ es una matriz diagonal 
    cuyos elementos son los \textbf{valores propios de} $B$, tales que
    \[
    \lambda_\alpha \ge 0, \quad \lambda_1 \ge \lambda_2 \ge \cdots \ge \lambda_p.
    \]
\end{itemize}

\end{frame}

\begin{frame}{Ejemplo. El Academic Rank of World Universities}
Esto significa que para obtener los valores de la tabla hay que ajustar los valores que produce la combinación lineal. Por ejemplo, para la universidad de Cambridge:
\begin{align*}
	x_5&=0.1\times 88.5+ 0.2\times 92.6 +0.2\times 53.9 + 0.2\times 54.3 + 0.2\times 65.7\\
	& + 0.1\times 53.1= 0.6746
\end{align*}
% <<>>=
% 0.1* 88.5+ 0.2* 92.6 +0.2* 53.9 + 0.2* 54.3 + 0.2* 65.7 + 0.1* 53.1
% @


y por tanto después de ajustado $67.46/0.9692=69.6$.
\end{frame}
% 
\section{Componentes principales: una combinación lineal espécifica}
\begin{frame}{Combinación lineal que produce las componentes principales}
\small
Las componentes principales son combinaciones lineales de los valores de las variables para cuya construcción se utilizan unas ponderaciones $v_1^\prime = (v_{11}, \ldots, v_{p1})$ tales que por ejemplo, la primera componente para el objeto $i$ cuyas observaciones para las $p$ variables están la iésima fila de $Y$ la matriz de datos centrados estandarizados $y_{i.}$ tiene la forma:
%  = (y_{i1},\ldots,y_{ip})^\prime
\begin{equation}\label{primeraCP}
	z_{i1} = y_{i.}^\prime v_1 = \sum_{j=1}^p v_{j1}y_{ij}, \, i=1,\dots,n 
\end{equation}
$z_{i1}$ es un promedio ponderado de los valores de las variables observadas en el objeto $i$. 

La primera componente para el objeto $i$ es la proyección de los valores de las variables sobre el vector de ponderaciones $v_1$. 

En el siguiente capítulo se hace la construcción formal de las componentes y las ponderaciones.
\end{frame}

\begin{frame}{Combinación lineal que produce las componentes principales}
Como se verá en el siguiente capítulo, estas componentes tienen, entre otras, dos importantes propiedades: 

\textbf{van en direcciones que acumulan la mayor cantidad posible de varianza de la tabla de datos} $X$, útil para reducir la dimensionalidad del problema en el sentido de que basta con unas cuantas de ellas para interpretar y descubrir asociaciones e información intrínseca en los datos.

que \textbf{todas las componentes son ortogonales entre sí}, que facilita representaciones gráficas de los datos.
\end{frame}
%
\begin{frame}{Teorema de la descomposición espectral (\textbf{TDE})}
\small
Este teorema garantiza que una matriz simétrica 
$B_{p\times p}$, como la matriz de covarianzas o de correlación 
(ambas semidefinidas positivas), se puede reconstruir (o factorizar) 
a partir de sus \textbf{valores} y \textbf{vectores propios} como sigue:

\begin{equation}\label{TDespectr}
B = U \Lambda U^\prime
\end{equation}

donde:

\begin{itemize}
    \item $U_{p\times p}$ es una \textbf{matriz ortogonal}, cuyas columnas son los 
    \textbf{vectores propios estandarizados de} $B$, es decir,
    \[
    U^\prime U = U U^\prime = I_p.
    \]
    
    \item $\Lambda = \mathrm{diag}(\lambda_1,\ldots,\lambda_p)$ es una matriz diagonal 
    cuyos elementos son los \textbf{valores propios de} $B$, tales que
    \[
    \lambda_\alpha \ge 0, \quad \lambda_1 \ge \lambda_2 \ge \cdots \ge \lambda_p.
    \]
\end{itemize}

\end{frame}
% 
\begin{frame}{Teorema de la descomposición en valores singulares  (\textbf{TDVS})}\label{TeoremaDVS_0}

\tiny

La descomposición en valores singulares es más general que el TDE, pues no requiere que la matriz a descomponer sea simétrica, lo cual garantiza que también la matriz de datos puede ser descompuesta.

El \textbf{TDVS} garantiza que una matriz 
\(C_{n\times p}\), con \(n \ge p\) y rango \(r\),
equivalentemente con \(r\) columnas linealmente independientes (por ejemplo la matriz de datos $X$ o la estandarizada $Y$ definida en (\ref{estandarizados})), se puede factorizar como (ver por ejemplo \cite{sudipto2014linear} \cite{MardiaKentBibby}):

\begin{equation}\label{TeoremaDVS}
	C = U L V^\prime
\end{equation}

donde:

\begin{itemize}
    
    \item $U$ y $V$ son matrices con columnas ortonormales, es decir,
    \[
    U^\prime U = V^\prime V = I_r.
    \]

    \item $L_{r\times r} = \mathrm{diag}(\sqrt{\lambda_1},\ldots,\sqrt{\lambda_r})$,
    con
    \[
    \sqrt{\lambda_1} \ge \sqrt{\lambda_2} \ge \cdots \ge \sqrt{\lambda_r} > 0.
    \]

    \item $\sqrt{\lambda_j}$ son los \textbf{valores singulares} de $C$.

    \item $V_{p\times r} = (v_1,\ldots,v_r)$ contiene en sus columnas los vectores propios de $C^\prime C$.

    \item $U_{n\times r} = (u_1,\ldots,u_r)$ contiene en sus columnas los vectores propios de $CC^\prime$.

\end{itemize}

La equivalencia con los valores propios no nulos de \(CC'\) se establece tomando
\[
L = \mathrm{diag}(\sqrt{\mu_1},\ldots,\sqrt{\mu_r}),
\]
donde \(\mu_\alpha\) es el \(\alpha\)-ésimo valor propio no nulo de \(CC'\).

\end{frame}

% ===================================================================
\begin{frame}{Reconstrucción de la matriz de datos a partir del TDVS}

\small

\textbf{Reconstrucción de la matriz de puntajes en los criterios del ranking ARWU a partir del TDVS}

El ejercicio implica los siguientes pasos:

\begin{enumerate}
    
    \item \textbf{Lectura de los datos} y construcción de la matriz 
    $C \in \mathbb{R}^{n \times p}$.

    \item \textbf{Cálculo de las matrices}
    \[
    C'C \quad \text{y} \quad CC'.
    \]

    \item \textbf{Cálculo de}
    \begin{itemize}
        \item los valores propios de $C'C$,
        \item la matriz $V$ de vectores propios de $C'C$.
    \end{itemize}

    \item \textbf{Selección de los valores propios estrictamente positivos} 
    y construcción de la submatriz $V_r$ con los vectores propios asociados.

    \item \textbf{Cálculo de los valores singulares} de $C$:
    \[
    \sigma_\alpha = \sqrt{\lambda_\alpha}.
    \]

    \item \textbf{Construcción de la matriz diagonal}
    \[
    L = \mathrm{diag}(\sigma_1, \ldots, \sigma_r).
    \]

    \item \textbf{Cálculo de la matriz $U$} de vectores propios de $CC'$ mediante
    \[
    U = C V_r L^{-1}, \quad \text{donde } U'U = I_r.
    \]

    \item \textbf{Reconstrucción de la matriz} $C$ usando el TDVS:
    \[
    C = U L V_r'.
    \]

    \item \textbf{Evaluación del error de reconstrucción}, calculando la diferencia:
    \[
    \| C - U L V_r' \|_F \approx 0
    \]

\end{enumerate}

\end{frame}

\begin{frame}{Laboratorio (1/4)}

\small

Utilizar los datos del archivo \texttt{original-filtrado-con etiquetas} y los mismos grupos de variables asignados en el ejercicio \ref{exer_atipicos1} del Laboratorio \ref{lab1}, junto con la subtabla de indicadores de Recursos Humanos del mismo archivo de ciudades, para conformar una nueva tabla que contenga los dos conjuntos de variables.

\vspace{0.2cm}

\begin{enumerate}
    \item Calcular el vector de medias de todas las variables del conjunto que le correspondió al grupo. \label{vmed}
    
    \item Calcular la matriz de datos centrados.
    
    \item Calcular la matriz de covarianzas a partir de la matriz de datos centrados.
\end{enumerate}

\end{frame}

\begin{frame}{Laboratorio (2/4)}

\small

\begin{enumerate}
\setcounter{enumi}{3}

    \item Calcular la matriz de covarianzas con el comando \texttt{cov} de \textsf{R}. 
    ¿Coincide con la obtenida a partir de la matriz de datos centrados? 
    ¿Sí? ¿No? ¿Por qué?
    
    \item Calcular la matriz $\widetilde{Y}$ de datos centrados estandarizados a partir del punto \ref{vmed}.
    
    \item Calcular la matriz de correlación a partir de la matriz de datos centrados estandarizados. 
    Calcular también la matriz de correlación con el comando \texttt{cor} de \textsf{R}. 
    ¿Coincide con $\frac{1}{n}\widetilde{Y}'\widetilde{Y}$? 
    ¿Sí? ¿No? ¿Por qué?
    
\end{enumerate}

\end{frame}

\begin{frame}{Laboratorio (3/4)}

\small

\begin{enumerate}
\setcounter{enumi}{6}

    \item Calcular la matriz de covarianzas $S$ e identificar las dos variables con mayor covarianza y las dos con menor covarianza. \label{2}
    
    \item Calcular la matriz de correlación $R$ e identificar las dos variables con mayor correlación y las dos con menor correlación. 
    ¿Son las mismas que las que tienen mayor y menor covarianza identificadas en el punto \ref{2}? \label{5}
    
    \item Calcular el producto $\frac{1}{n}Y^\prime Y$ y verificar que es exactamente la matriz $R$ obtenida en el punto \ref{5}. 
    ¿Por qué?

\end{enumerate}

\end{frame}

\begin{frame}{Laboratorio (4/4)}

\scriptsize

\begin{enumerate}
\setcounter{enumi}{9}

    \item Comprobar que la matriz de covarianzas se puede obtener con el producto
    \[
    \frac{1}{n}\widetilde{X}^\prime \widetilde{X}.
    \]

    \item Comprobar que la matriz de correlación se puede obtener con el producto
    \[
    \frac{1}{n}Y^\prime Y.
    \]

    \item Construir una matriz de datos con los puntajes en los seis criterios del ranking ARWU para las universidades asignadas al grupo y comprobar que con el TDVS se puede reconstruir.

\end{enumerate}

\begin{itemize}\scriptsize
    \item \textbf{Grupo 1:} universidades en puestos 91 a 100 inclusive.
    \item \textbf{Grupo 2:} universidades en puestos 81 a 90 inclusive.
    \item \textbf{Grupo 3:} universidades en puestos 71 a 80 inclusive.
    \item \textbf{Grupo 4:} universidades en puestos 61 a 70 inclusive.
    \item \textbf{Grupo 5:} universidades en puestos 51 a 60 inclusive.
    \item \textbf{Grupo 6:} universidades en puestos 41 a 50 inclusive.
\end{itemize}

\end{frame}

