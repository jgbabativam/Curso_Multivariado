\section{Observaciones multivariadas}
\begin{frame}{Observaciones multivariadas}
Para la construcción de los análogos multivariados de las medidas descriptivas univariadas primero se requiere definir las observaciones multivariadas.

En el contexto multivariado en lugar de una se observan $p$ variables $X_1,\ldots,X_p$ simultáneamente sobre mismo un objeto $i$ (que puede ser una ciudad, una universidad, una planta, una persona), y por tanto una observación para el objeto $i$ es un vector de $p$ componentes 
$$x_i = \left(x_{i1},\ldots,x_{ij},\ldots,x_{ip}\right)^\prime,$$
donde $x_{ij}$ es la observación de la variable $j$ sobre el objeto $i$. 
\end{frame}

\section{Datos}
\begin{frame}{Tabla de datos}
Para $n$ objetos las observaciones se arreglan en una tabla de datos como la siguiente:
\begin{table}[H]
  \centering
  % \caption{Add caption}
    \begin{tabular}{ccccc}
           &            & Variables          &       & \\
    \toprule
    Objeto &     $ X_1$ & $\cdots$ $X_j$    & $\cdots$ &     $X_p$ \\
    \midrule
    1     &    $x_{11}$ & $\cdots$ $x_{1j}$ & $\cdots$ & $x_{1p}$ \\
    $\vdots$ & $\vdots$ & $\cdots$ $\vdots$ & $\vdots$ & $\vdots$ \\
    $\vdots$ & $\vdots$ & $\cdots$ $x_{ij}$ & $\cdots$ & $\vdots$ \\
    $\vdots$ & $\vdots$ & $\cdots$ $\vdots$ & $\vdots$ & $\vdots$ \\
    n        & $x_{n1}$ & $\cdots$ $x_{nj}$ & $\cdots$ & $x_{np}$ \\
    \bottomrule
    \end{tabular}%
  \label{tab:addlabel}%
\end{table}%
\end{frame}

\begin{frame}{Media, Varianza, Covarianza y Coeficiente de correlación:}
\begin{align}\label{ec:descrpunivar}
\bar{x}_j = med(X_j) = &=\frac1n \sum_{i=1}^{n} x_{ij}  \qquad \qquad \text{media de la variable } X_j \notag \\
s_j^2 = var(X_j) &= \frac1n \sum_{i=1}^{n} (x_{ij}-\bar{x}_j)^2 \qquad \text{varianza de la variable } X_j \notag \\
s_{jk} = cov(X_j,X_k)&= \frac1n \sum_{i=1}^{n} (x_{ij}-\bar{x}_j)(x_{ik}-\bar{x}_k), \quad\quad s_{jj} = s_j^2 \notag \\
r_{jk}= corr(X_j,X_k)& =  \frac{s_{jk}}{s_j s_k}, \quad\quad s_j = \sqrt{s_j^2}
\end{align}
{\footnotesize Nótese que para el cálculo de la varianza se utilizó como denominador $n$ debido a que en datos multivariados se considera suficientemente grande como para que $s^2$ siga siendo un estimador insesgado de la varianza poblacional\footnote{En $R$ se utiliza $n-1$ y por tanto para los cálculos debe hacerse la modificación en la salida del comando var()}.}
\end{frame}
% 
\begin{frame}{Media, Varianza, Covarianza y Coeficiente de correlación:}
Nótese que para el cálculo de la varianza y la covarianza se utilizó como denominador $n$ debido a que en datos multivariados se considera suficientemente grande como para que $s^2$ siga siendo un estimador insesgado de la varianza poblacional.

Los comandos var() y cov() de $R$ utilizan $n-1$ y por tanto para los cálculos debe hacerse la modificación correspondiente.
\end{frame}
% 

\begin{frame}{Tabla de datos}
\textbf{tabla} para referirse a los datos con nombres en las filas y columnas

\textbf{matriz} cundo se van a utilizar las propiedades algebraicas de la tabla

$$ X= \left\{x_{ij} \right\} = \left[ \begin{array}{cccc}
x_{11}&\cdots x_{1j}& \cdots& x_{1p}\\
\vdots&  \vdots& \vdots& \vdots\\
x_{i1}&\cdots x_{ij}& \cdots& x_{ip}\\
\vdots&  \vdots& \vdots& \vdots\\
x_{n1}&\cdots x_{nJ}& \cdots& x_{np}
\end{array} \right]$$
\end{frame}

\begin{frame}{Columna de la tabla de datos}
En esta matriz la columna $j$, o el punto variable $j$, representa las observaciones de la variable $X_j$ sobre los $n$ objetos y se denota como un vector columna:
$$X_{. j}= \left[ \begin{array}{c}
x_{1j}\\
x_{2j}\\
\vdots\\
x_{nj}\\
\end{array} \right], j=1,\ldots,p
$$
\end{frame}

\begin{frame}{Fila de la tabla de datos}
Análogamente, la fila $i$, o el punto objeto $i$, representa las observaciones de las $p$ variables sobre el objeto $i$ que se denota como un vector columna;
$$
x_{i.} = \left(x_{i1},\ldots,x_{ip}\right)^\prime = \left[ \begin{array}{c}
x_{i1}\\
x_{i2}\\
\vdots\\
x_{ip}\\
\end{array} \right], i=1,\ldots,n.
$$
\end{frame}
% 
