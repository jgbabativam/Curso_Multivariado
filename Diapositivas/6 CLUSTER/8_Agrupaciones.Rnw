%
\section{Agrupación jerárquica a partir componentes principales}
\begin{frame}{Agrupación jerárquica a partir de componentes principales}
{Algoritmo}
\begin{itemize}
\item Realizar un método factorial a los datos originales con lo cual se reduce la dimensionalidad y se identifican los factores que se utilizarán para el agrupamiento.
\item Seleccionar $q \le p$ factores para usarlos como información de arranque para la  agrupación
\item Tipificar las grupos comparando las estadísticas básicas de las variables originales por grupos con las mísmas estadísticas pero calculadas para el conjunto completo de datos.
\item Posicionar las grupos en los planos factoriales.
\end{itemize}
\end{frame}
%
\begin{frame}[fragile]
{Ejemplo Arwu 2}
{Agrupamiento de paises por puntajes promedio de los indicadores del ARWU a partir de un ACP.}
\begin{block}{ARWU}
<<clusterPCA1, fig=F,results=tex, echo=FALSE>>=
res.PCA<-PCA(mediaspais)
eig = round(res.PCA$eig, 2)
kable(eig, "latex", booktabs = T, 
      caption = "Valores propios y varianzas del ACP de indicadores del SUE", label = "vp_sue") %>%
kable_styling(latex_options = c("striped", "scale_down", 
                                "hold_position"))
@

\end{block}
\end{frame}
%
\begin{frame}[fragile]
{Ejemplo Arwu 2}
{Agrupamiento de paises por puntajes promedio de los indicadores del ARWU a partir de un ACP.}
\begin{block}{ARWU}
<<results=tex, echo=FALSE>>=
coo = res.PCA$var$cor[,1:4]
coo = coo[order(coo[,1], decreasing = T),]
kable(coo, "latex", booktabs = T, 
      caption = "Coordenadas sobre los primeros cuatro factores del ACP de indicadores del SUE", label = "coor") %>%
kable_styling(latex_options = c("striped", "hold_position"))
@
\end{block}
\end{frame}
% 
\begin{frame}[fragile]
{Ejemplo Arwu 2}
{Agrupamiento de paises por puntajes promedio de los indicadores del ARWU a partir de un ACP.}
\begin{block}{ARWU}
<<results=tex, echo=FALSE>>=
cont = res.PCA$var$contrib[,1:4]
cont = cont[order(cont[,1], decreasing = T),]
kable(cont, "latex", booktabs = T, 
      caption = "Contribuciones a la varianza de los primeros cuatro factores del ACP de indicadores del SUE", label = "contr") %>%
kable_styling(latex_options = c("striped", "hold_position"))
@
\end{block}
\end{frame}
% 
\begin{frame}[fragile]
{Ejemplo Arwu 2}
{Agrupamiento de paises por puntajes promedio de los indicadores del ARWU a partir de un ACP.}
\begin{block}{ARWU}
<<results=tex, echo=FALSE>>=
cos2 = res.PCA$var$cos2[,1:4]
cos2 =cos2[order(cos2[,1], decreasing = T),]
kable(cos2, "latex", booktabs = T, 
      caption = "Cosenos cuadrados sobre los primeros cuatro factores del ACP de indicadores del SUE", label = "cos2") %>%
kable_styling(latex_options = c("striped", "hold_position"))
@
\end{block}
\end{frame}
% 
\begin{frame}[fragile]
Para utilizar solamente los dos primeros factores es necesario correr de nuevo el PCA para retener solo éstos dos.
<<clusterPCA2, fig=F>>=
res.PCA2<-PCA(mediaspais, ncp = 2) 
@
Entonces se utiliza la salida del PCA con estas dos primeras componentes:
<<clusterPCA3, fig=F, width=4, height=4>>=
res.hcpc<-HCPC(res.PCA2, 
               nb.clust = -1, min = 3, max = 6, , proba=0.1)
@
\end{frame}
%
\begin{frame}[fragile]
\begin{figure}[H]
\centering
<<clusterPCA4_12, fig=T, width=4, height=3, echo=FALSE>>=
plot.HCPC(res.hcpc, axes = c(1,2), choice = "tree", title = "Agrupamiento Jerárquico")
@
\caption{El dendrograma sugiere cuatro grupos uno de los cuales está formado por Rusia y Francia, los dos países que sobresalen en el plano de países}\label{fig:dendropaises4grupos2}
\end{figure}
\end{frame}
%
\begin{frame}[fragile]
{Tipificación de los grupos}
\begin{block}{Datos originales y pertenencia a los grupos}
<<echo=FALSE, results=tex>>=
grps = res.hcpc$data.clust
grps =grps[order(grps[,7]),]
kable(grps, "latex", booktabs = T, 
      label = "grps1") %>%
kable_styling(latex_options = c("striped", "hold_position", "scale_down"))

@
\end{block}
\end{frame}
%
%
\begin{frame}[fragile]
{Descripción de los grupos por las variables}
<<echo=FALSE, results=tex>>=
q1 = res.hcpc$desc.var$quanti[1]
kable(q1, "latex", booktabs = T, caption = "Grupo 1: FR, RU",
      label = "grps1") %>%
kable_styling(latex_options = c("striped", "hold_position", "scale_down"))

q2 = res.hcpc$desc.var$quanti[2]
kable(q2, "latex", booktabs = T, caption = "Grupo 2: BE, FI, GE, IR, NL, NW SE",
      label = "grps1") %>%
kable_styling(latex_options = c("striped", "hold_position", "scale_down"))


@

\end{frame}

