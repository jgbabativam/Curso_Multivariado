cor3R<-round(preg16x17$row$coord[,1:2],2)
colnames(cor3R)<-c("Factor 1","Factor 2")
con3R<-round(preg16x17$row$contrib[,1:2],2)
colnames(con3R)<-c("Factor 1","Factor 2")
rownames(con3R)<-NULL
cos3R<-round(preg16x17$row$cos2[,1:2],2)
colnames(cos3R)<-c("Factor 1","Factor 2")
rownames(cos3R)<-NULL
@
% 
\begin{frame}[fragile]
{\textcolor{yellow}{Representación simultánea: }}
{Relaciones entre filas y columnas}
<<fig=F, echo=F>>=
require(FactoMineR)
preg16x17<-CA(as.data.frame.matrix(t16x17), graph = T)
@
\setkeys{Gin}{width=3.5\textwidth, height=0.8\textheight,keepaspectratio} % para redefinir el tama?o de los
\begin{figure}[H]
	\centering
<<fig=TRUE, echo=false>>=
      plot.CA(preg16x17, title = "Asociación entre los sentimientos" )
@
	\caption{Sentimientos ante palabras como regla o norma y facilidad para actuar conforme a la ley.}\label{fig:PlanoincumAcuerd}
\end{figure}
\end{frame}
