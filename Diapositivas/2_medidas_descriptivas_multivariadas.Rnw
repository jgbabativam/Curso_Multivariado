arwu<-read.csv2("G:/Mi unidad/1- multivariado aplicado 2023/Multivariado I 2024 Diapositivas/Archivos para diapositivas/arwu.csv")
rownames(arwu) = arwu$Institution
g1 = ggplot(arwu, aes(Regional.Rank, World.Rank, color = Country, label = Country))
g1 + geom_text()+theme_bw()+ggtitle("Rankings")
@
	\caption{Arwu...}\label{fig:arwuRegWorl}
\end{figure}
\end{frame}

