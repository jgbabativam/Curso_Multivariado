\begin{frame}{Rankings universidades latinoamericanas}

\begin{ejem}
\setkeys{Gin}{width=0.7\textwidth, height=0.5\textheight,keepaspectratio} % para redefinir el tamaño de los graficos
\begin{figure}[H]
	\centering
	
% ====================== nueva versión===========================
<<fig_grid_rankings, echo=FALSE, fig=TRUE, width=14, height=10>>=
library(ggrepel)
library(png)
library(grid)

##------------------------------------------------------------
## Layout: 2 filas
##  - Fila 1: (a) y (b)
##  - Fila 2: (c) centrada ocupando dos columnas
##------------------------------------------------------------
tp <- par(no.readonly = TRUE)

layout(matrix(c(1,2,
                3,4), nrow=2, byrow=TRUE))

par(mar = c(4.2, 4.2, 2.2, 1.2), mgp = c(2.4, 0.8, 0))

##==================== (a) Scimago vs QS =====================
x <- RankLatino$SC.Lac.Ranking
y <- RankLatino$QS.Ranking

plot(x, y, type="n",
     xlim=c(0,270), ylim=c(0,270),
     xlab="Ranking Scimago", ylab="Ranking QS")
abline(a=0,b=1,col="red",lty=2)

highlight_indices <- which(y < x)
for(i in seq_along(x)) {
  if(!(i %in% highlight_indices)) {
    text(x[i], y[i], RankLatino$Pais[i], cex=0.8, pos=2)
  }
}

delta <- 8
y_lab <- pmax(0, y[highlight_indices] - delta)
text(x[highlight_indices], y_lab,
     labels = RankLatino$Pais[highlight_indices],
     col="red", font=3, cex=0.8, pos=3)

mtext("a) Muchas universidades por encima de 150 en Sc \n posicionadas por debajo de 150 en Qs", side=3, adj=0, line=0.2, font=2)

##==================== (b) Scimago vs WEB ====================
x <- RankLatino$SC.Lac.Ranking
y <- RankLatino$WEB.Ranking.LA

plot(x, y, type="n",
     xlim=c(0,270), ylim=c(0,270),
     xlab="Ranking Scimago", ylab="WEB.Ranking")
abline(a=0,b=1,col="red",lty=2)

highlight_indices <- which(y < x)
for(i in seq_along(x)) {
  if(!(i %in% highlight_indices)) {
    text(x[i], y[i], RankLatino$Pais[i], cex=0.8, pos=2)
  }
}

y_lab <- pmax(0, y[highlight_indices] - delta)
text(x[highlight_indices], y_lab,
     labels = RankLatino$Pais[highlight_indices],
     col="red", font=3, cex=0.8, pos=3)

mtext("b) Muchas coincidencias en posiciones debajo de 150", side=3, adj=0, line=0.2, font=2)

##==================== (c) QS vs WEB (centrada) ===============
y <- RankLatino$QS.Ranking
x <- RankLatino$WEB.Ranking.LA

plot(x, y, type="n",
     xlim=c(0,270), ylim=c(0,270),
     xlab="WEB.Ranking", ylab="QS.Ranking")
abline(a=0,b=1,col="red",lty=2)

highlight_indices <- which(y < x)
for(i in seq_along(x)) {
  if(!(i %in% highlight_indices)) {
    text(x[i], y[i], RankLatino$Pais[i], cex=0.8, pos=2)
  }
}

y_lab <- pmax(0, y[highlight_indices] - delta)
text(x[highlight_indices], y_lab,
     labels = RankLatino$Pais[highlight_indices],
     col="red", font=3, cex=0.8, pos=3)

mtext("c) Similar a a) pero respecto al WEB.Ranking", side=3, adj=0, line=0.2, font=2)

par(tp)
@
\caption{Comparación entre rankings (Scimago, QS y WEB). Entre más lejos de la diagonal mas diferentes son los rankings correspondientes}
\label{fig:grid_rankings}
\end{figure}
\end{ejem}

\end{frame}
