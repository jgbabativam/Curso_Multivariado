datos <- perf_fil[!rownames(perf_fil) %in% c("Total_C", "Total_F"), , drop = FALSE]

# Asegurar que sea data.frame y conservar nombres de filas
datos <- as.data.frame(perf_fil)

# (Opcional) eliminar filas de to7tales si existieran
datos <- datos[!rownames(datos) %in% c("Total_C", "Total_F"), , drop = FALSE]

# Extraer perfil de muchis. (columna puede existir con ese nombre)
muchis <- datos[["muchis."]]   # <- funciona aunque el nombre tenga punto

datos_df <- data.frame(
  Pais   = rownames(datos),
  Muchis = as.numeric(muchis)
)

