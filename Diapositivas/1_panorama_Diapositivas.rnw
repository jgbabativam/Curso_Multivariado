% Plano 1-2
\begin{frame}
\begin{ejem}
\setkeys{Gin}{width=0.6\textwidth, height=0.5\textheight,keepaspectratio} % para redefinir el tama?o de los graficos
\begin{figure}[H]
\centering
<<echo=FALSE, fig=TRUE>>=
# paso 1 componentes principales
pca <- prcomp(xsue, scale. = TRUE)

coord <- as.data.frame(pca$x[,1:2])
colnames(coord) <- c("PC1","PC2")
# paso 2. corte arbol
cl <- cutree(hsue, k = 3)
coord$cluster <- factor(cl)
# Paso 3. gráfico
library(ggplot2)
library(ggrepel)

coord$Universidad <- rownames(xsue)

ggplot(coord, aes(PC1, PC2, color = cluster, label = Universidad)) +
  geom_point(size = 3) +
  geom_text_repel(size = 3) +
  stat_ellipse(level = 0.9) +
  labs(title = "Clusters jerárquicos (Ward) en el plano PC1–PC2") +
  theme_minimal()
@
\caption{Agrupamiento de universidades del SUE en tres grupos}\label{fig:plano_1_2}
\end{figure}
\end{ejem}
\end{frame}

%------------------------------------------------
% Diapositiva: IQR y detección de atípicos (1 variable)
%------------------------------------------------
\begin{frame}{Datos atípicos en una variable: Rango intercuartílico \textcolor{yellow}{(IQR)}}

\textbf{Definición (medida de dispersión).}
El \textbf{rango intercuartílico} es una medida robusta de dispersión definida por:
\[
IQR = Q_{0.75} - Q_{0.25}.
\]

\textbf{Construcción del rango para detectar atípicos.}
A partir del IQR se define el intervalo:
\[
\left( Q_{0.25} - 1.5\,IQR,\;\; Q_{0.75} + 1.5\,IQR \right),
\]
y una observación se considera \textbf{atípica} si cae por fuera de este rango.
\end{frame}
% 
\begin{frame}{Datos atípicos en una variable: Rango intercuartílico \textcolor{yellow}{(IQR)}}
\textbf{Motivación (referencia normal).}
Esta regla es coherente con la idea de concentración de probabilidad en la
distribución normal $N(\mu,\sigma^2)$: aproximadamente 

el 68\% de las obs. se encuentran en el intervalo $\mu \pm \sigma$, 

el 95\% \hspace{4.5cm} en el intervalo $\mu \pm 2\sigma$ 

el 99\% \hspace{4.5cm} en el intervalo $\mu \pm 3\sigma$.
\end{frame}
% 
\begin{frame}{Indicadores de educación y número de habitantes ciudades colombianas}
\begin{ejem}
El archivo ciudades contiene datos del número de habitantes y cuatro indicadores de educación en 22 ciudades colombianas. Tabla \ref{tab:edu_ciudades_col}.
\end{ejem}
\end{frame}
% 
\begin{frame}{Indicadores de educación y número de habitantes ciudades colomhbianas}
\begin{ejem}

<<results=tex, echo=FALSE>>=
ciudades<-read.csv2("G:/Mi unidad/Multivariado/Multivariado 2018 II/Notas de clase 2023/ciudades.csv", sep=";")
kable(ciudades, "latex", booktabs = TRUE, digits = 2,
      caption = "Indicadores de educación y número de habitantes para 22 ciudades colombianas",
      label = "edu_ciudades_col") %>%
  kable_styling(latex_options = c("striped", "scale_down", "hold_position"))
@
\end{ejem}
\end{frame}
% 
\begin{frame}{Ciudades atípicas}
\begin{ejem}
<<results=tex, echo=FALSE>>=
library(knitr)
library(kableExtra)
library(magrittr)

# Inicializando vectores
Limite_inferior <- vector()
Limite_superior <- vector()
q1  <- vector()
q3  <- vector()
iqr <- vector()

# Cuartiles e IQR
for (i in 2:6) {
  q1[i]  <- quantile(ciudades[, i], 0.25, na.rm = TRUE)
  q3[i]  <- quantile(ciudades[, i], 0.75, na.rm = TRUE)
  iqr[i] <- q3[i] - q1[i]
}

# Límites
for (i in 2:6) {
  Limite_inferior[i] <- q1[i] - 1.5 * iqr[i]
  Limite_superior[i] <- q3[i] + 1.5 * iqr[i]
}

# Copia para resaltar atípicos
ciudades_highlight <- ciudades

# Marcar atípicos con "*"
for (i in 2:6) {
  ciudades_highlight[
    ciudades[, i] < Limite_inferior[i] | ciudades[, i] > Limite_superior[i],
    i
  ] <- "*"
}

# Renombrar columna de ciudades (opcional pero recomendable)
names(ciudades_highlight)[1] <- "Ciudad"

# Imprimir tabla COMPLETA (sin quitar la columna 1)
kable(ciudades_highlight, "latex", booktabs = TRUE, digits = 2,
      caption = "Ciudades atípicas por cada variable",
      label = "CiudAtipicas2") %>%
  kable_styling(latex_options = c("striped", "scale_down", "hold_position"))
@

\end{ejem}
\end{frame}
% 
