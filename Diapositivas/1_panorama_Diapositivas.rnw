# Mostrar tabla en LaTeX
kable(confianzaJUstcia_filtrado_tot, "latex", booktabs = TRUE, 
      caption = "Confianza en la justicia en países seleccionados", label = "conf_just_lat") %>%
  kable_styling(latex_options = c("striped", "hold_position"))

@
\end{ejem}
\end{frame}
