\begin{frame}{Datos atípicos en dos variables - Distancia de Mahalanobis}
\begin{ejem}Problema
\vskip-1.5cm
\setkeys{Gin}{width=1\textwidth} % redefinir tamaño de los graficos graficos
\begin{figure}[H]
\centering
<<fig=TRUE, width=5.5, height=4, echo=FALSE>>=
cities <- ciudades[,1]

# Índice de Riohacha
i_rio <- which(cities == "Riohacha")

plot(ciudades$Rel.al.prof, ciudades$Analfabetismo,
     xlab = "Relación alumno profesor",
     ylab = "Analfabetismo",
     xlim = c(19,27),
     xaxt = "n")

axis(side = 1, at = 19:27)

# Todas las ciudades en negro
text(ciudades$Rel.al.prof,
     ciudades$Analfabetismo,
     cities,
     cex = 0.5,
     pos = 2,
     col = "black")

# Riohacha en rojo (encima)
text(ciudades$Rel.al.prof[i_rio],
     ciudades$Analfabetismo[i_rio],
     cities[i_rio],
     cex = 0.6,
     pos = 2,
     col = "red",
     font = 2)   # opcional: negrilla
@

\caption{Relación alumno profesor vs. Analfabetismo en 10 ciudades colombianas (r=0.76). Se distinguen en los extremos las ciudades de San Andrés y Riohacha.}\label{ciudadesDispersion1}
\end{figure}
\end{ejem}
\end{frame}
% 
\begin{frame}
\begin{ejem}Problema
\vskip-1.5cm
\setkeys{Gin}{width=1\textwidth} % redefinir tamaño de los graficos graficos
\begin{figure}[H]
\centering
<<fig=TRUE, width=5.5, height=4, echo=FALSE>>=
cities <- as.character(ciudades[,1])

norm <- function(x){
  x <- trimws(x)
  x <- tolower(x)
  iconv(x, from = "", to = "ASCII//TRANSLIT")
}
cities_n <- norm(cities)

i_rio <- which(cities_n == norm("Riohacha"))

blue_cities <- c("Medellín", "Montería", "Villavicencio",
                 "Sincelejo", "Valledupar", "Cartagena")
i_blue <- which(cities_n %in% norm(blue_cities))

i_black <- setdiff(seq_along(cities), union(i_blue, i_rio))

plot(ciudades$Rel.al.prof, ciudades$Analfabetismo,
     xlab = "Relación alumno profesor",
     ylab = "Analfabetismo",
     xlim = c(19,27),
     xaxt = "n")
axis(side = 1, at = 19:27)

# Negras (solo no destacadas)
text(ciudades$Rel.al.prof[i_black],
     ciudades$Analfabetismo[i_black],
     cities[i_black],
     cex = 0.5, pos = 2, col = "black")

# Índices de las que quiere mover
i_villa <- which(cities_n == norm("Villavicencio"))
i_sinc  <- which(cities_n == norm("Sincelejo"))

# Azules "base": todas menos Villavicencio y Sincelejo (para no duplicar)
i_blue_base <- setdiff(i_blue, c(i_villa, i_sinc))

text(ciudades$Rel.al.prof[i_blue_base],
     ciudades$Analfabetismo[i_blue_base],
     cities[i_blue_base],
     cex = 0.6, pos = 2, col = "blue", font = 2)

# Villavicencio (una sola vez) con desplazamiento
text(ciudades$Rel.al.prof[i_villa] + 0.15,
     ciudades$Analfabetismo[i_villa] - 0.004,
     cities[i_villa],
     cex = 0.6, col = "blue", font = 2)

# Sincelejo (una sola vez) con desplazamiento
text(ciudades$Rel.al.prof[i_sinc] - 0.15,
     ciudades$Analfabetismo[i_sinc] + 0.004,
     cities[i_sinc],
     cex = 0.6, col = "blue", font = 2)

# Riohacha en rojo
text(ciudades$Rel.al.prof[i_rio],
     ciudades$Analfabetismo[i_rio],
     cities[i_rio],
     cex = 0.65, pos = 2, col = "red", font = 2)
@

\end{figure}
\end{ejem}
\end{frame}
% 
\begin{frame}
\begin{ejem}Otro problema
\vskip-1.5cm
\setkeys{Gin}{width=1\textwidth} % redefinir tamaño de los graficos graficos
\begin{figure}[H]
\centering
<<fig=TRUE, width=5.5, height=4, echo=FALSE>>=
cities <- as.character(ciudades[,1])

# Índices de ciudades destacadas
i_rio <- which(cities == "Riohacha")
i_bog <- which(cities == "Bogota" | cities == "Bogotá")

# Índices que SÍ van en negro (todas menos Bogotá y Riohacha)
i_black <- setdiff(seq_along(cities), c(i_rio, i_bog))

plot(ciudades$Num.Hab, ciudades$Analfabetismo,
     xlab = "Número de Habitantes",
     ylab = "Analfabetismo",
     ylim = c(0, 0.3))

# Etiquetas negras (excepto Bogotá y Riohacha)
text(ciudades$Num.Hab[i_black],
     ciudades$Analfabetismo[i_black],
     cities[i_black],
     cex = 0.5,
     pos = 3,
     col = "black")

# Riohacha en rojo
text(ciudades$Num.Hab[i_rio],
     ciudades$Analfabetismo[i_rio],
     cities[i_rio],
     cex = 0.6,
     pos = 3,
     col = "red",
     font = 2)

# Bogotá en azul
text(ciudades$Num.Hab[i_bog],
     ciudades$Analfabetismo[i_bog],
     cities[i_bog],
     cex = 0.6,
     pos = 3,
     col = "blue",
     font = 2)
@
\end{figure}
\end{ejem}
\end{frame}
% 
\begin{frame}{\textcolor{yellow}{Distancia de Mahalanobis en dos variables}}
Es una medida de la distancia entre observaciones multivariadas con la propiedad de que incluye tanto las distancias euclidianas entre las variables, como el grado de correlación entre ellas. 
\end{frame}
% 
\begin{frame}{\textcolor{yellow}{Distancia de Mahalanobis entre observaciones de dos variables}}
Asumiendo que hay $n$ observaciones para dos variables $X_1$ y $X_2$:
\footnotesize
$$
\left[
\begin{array}{cc}
x_{11}& x_{12}\\
\vdots& \vdots\\
x_{i1}& x_{i2}\\
\vdots& \vdots\\
x_{i^\prime 1}& x_{i^\prime 2}\\
\vdots& \vdots\\
x_{n1}& x_{n2}
\end{array}
\right]
$$

\begin{align}\label{mahalanobis2var}
d_M^2(i,i^\prime)
&=\frac{1}{(1-r_{12} ^2)}
\left[
\frac{(x_{i1}-x_{x_{i^\prime 1}})^2}{s_1^2}
+ \frac{(x_{i2}-x_{i^\prime 2})^2}{s_2^2}
- 2r_{12}\frac{(x_{i1}-x_{i^\prime 1})(x_{i2}-x_{i^\prime 2})}{s_1s_2}
\right]
\end{align}
$\frac{(x_{i1}-x_{i^\prime 1})^2}{s_1^2}$ y $\frac{(x_{i2}-x_{i^\prime 2})^2}{s_2^2}$ son las distancias euclidianas estandarizadas entre los dos puntos y $r_{12}$ es el coeficiente de correlación entre $X_1$ y $X_2$.
\end{frame}
% 
\begin{frame}{Interpretación de la distancia de Mahalanobis en dos variables}

\begin{itemize}
\item \textbf{Cuando $r_{12} \to 0$:}  
las variables son aproximadamente incorrelacionadas y la distancia de Mahalanobis
se reduce esencialmente a una suma de distancias euclidianas estandarizadas.

\item \textbf{Cuando $r_{12} \to 1$:}  
las variables están fuertemente correlacionadas de forma positiva; las diferencias
en la dirección común de variación aportan poco a la distancia, mientras que las
desviaciones ortogonales se amplifican.

\item \textbf{Cuando $r_{12} \to -1$:}  
existe una correlación negativa fuerte; las diferencias opuestas entre $X_1$ y $X_2$
se penalizan menos, y las discrepancias fuera de esa relación lineal incrementan la
distancia.
\end{itemize}
\end{frame}
% 
\begin{frame}{Distancia de Mahalanobis y estimación de la varianza}

\begin{itemize}

\item \textbf{Distancia a la media multivariada}

La distancia de Mahalanobis de la observación $i$ al centro de los datos se obtiene
reemplazando $x_{i^\prime}$ por la media
\[
\bar{\mathbf{x}}=(\bar{x}_1,\bar{x}_2),
\]
lo que permite cuantificar la separación de cada individuo respecto a la estructura
global de las variables.

\vspace{0.15cm}

\item \textbf{Estimación de las varianzas}

Para cada variable se utiliza usualmente el estimador insesgado
\[
s_j^2=\frac{1}{n-1}\sum_{i=1}^n (x_{ij}-\bar{x}_j)^2,\qquad j=1,2.
\]
En contextos poblacionales o para tamaños muestrales grandes puede emplearse el
denominador $n$, ya que la diferencia entre $n$ y $n-1$ resulta despreciable.
\end{itemize}
\end{frame}
 %
 \begin{frame}{Caso particular: dos observaciones y dos variables}

\begin{itemize}

\item \textbf{Matriz de datos reducida}

Cuando solo se dispone de dos observaciones, la matriz de datos es
\[
\begin{bmatrix}
x_{11} & x_{12}\\
x_{21} & x_{22}
\end{bmatrix}.
\]

\vspace{0.15cm}

\item \textbf{Varianzas como sumas de cuadrados}

Dado que $n=2$, las varianzas se reducen a
\[
s_j^2=\sum_{i=1}^2 (x_{ij}-\bar{x}_j)^2,\qquad j=1,2.
\]

\vspace{0.15cm}

\item \textbf{Interpretación}

Este caso es fundamentalmente ilustrativo y tiene escaso interés práctico, debido a la
inestabilidad inherente a trabajar con un número extremadamente pequeño de observaciones.

\end{itemize}

\end{frame}

